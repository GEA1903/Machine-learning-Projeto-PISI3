   "source": [
    "# 1. Função de limpeza para unificar as categorias zumbis\n",
    "def limpar_grupos(texto):\n",
    "    texto = str(texto).upper()\n",
    "    if 'ILUMINA' in texto: return 'ILUMINACAO PUBLICA'\n",
    "    if 'ARBORIZA' in texto: return 'ARBORIZACAO'\n",
    "    if 'DRENA' in texto: return 'DRENAGEM'\n",
    "    if 'PAVIMENT' in texto: return 'PAVIMENTACAO'\n",
    "    if 'LIMPEZA' in texto or 'LIXO' in texto: return 'LIMPEZA URBANA'\n",
    "    return texto.strip()\n",
    "\n",
    "# Aplica a limpeza na coluna original\n",
    "df_all['GRUPOSERVICO_DESCRICAO'] = df_all['GRUPOSERVICO_DESCRICAO'].apply(limpar_grupos)\n",
    "\n",
    "top5_cat = df_all['GRUPOSERVICO_DESCRICAO'].value_counts().head(5).index\n",
    "df_top5_cat = df_all[df_all['GRUPOSERVICO_DESCRICAO'].isin(top5_cat)]\n",
    "\n",
    "vol_mes_cat = df_top5_cat.groupby(['Mes', 'GRUPOSERVICO_DESCRICAO']).size().reset_index(name='Volume')\n",
    "\n",
    "# 4. Gráfico de Barras Agrupado\n",
    "fig2 = px.bar(\n",
    "    vol_mes_cat, \n",
    "    x='Mes', \n",
    "    y='Volume', \n",
    "    color='GRUPOSERVICO_DESCRICAO',\n",
    "    barmode='group', \n",
    "    title='2. Sazonalidade das Categorias (Top 5 Serviços por Mês)',\n",
    "    labels={'Mes': 'Mês do Ano (1 a 12)', 'GRUPOSERVICO_DESCRICAO': 'Categoria'},\n",
    "    color_discrete_sequence=px.colors.qualitative.Safe # Cores mais profissionais\n",
    ")\n",
    "\n",
    "fig2.show()"
   ]
  },
