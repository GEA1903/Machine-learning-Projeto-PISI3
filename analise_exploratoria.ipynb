   "source": [
    "# 1. Limpeza da coluna\n",
    "def limpar_situacao(texto):\n",
    "    texto = str(texto).upper()\n",
    "    if 'ATENDIDA' in texto: return 'ATENDIDA'\n",
    "    if 'CADASTRADA' in texto: return 'CADASTRADA'\n",
    "    if 'PREPARA' in texto: return 'PREPARACAO'\n",
    "    if 'EXECU' in texto: return 'EXECUCAO'\n",
    "    if 'FISCALIZA' in texto: return 'FISCALIZACAO'\n",
    "    if 'PENDEN' in texto: return 'PENDENTE'\n",
    "    return texto.strip()\n",
    "\n",
    "df_all['SITUACAO'] = df_all['SITUACAO'].apply(limpar_situacao)\n",
    "\n",
    "# 2. Filtrar os bairros críticos\n",
    "bairros_criticos = ['BOA VIAGEM', 'IMBIRIBEIRA', 'IPUTINGA', 'SANTO AMARO', 'VARZEA']\n",
    "df_ponto6 = df_all[df_all['BAIRRO'].isin(bairros_criticos)]\n",
    "\n",
    "# 3. Gerar o Gráfico usando HISTOGRAM\n",
    "fig6 = px.histogram(\n",
    "    df_ponto6, \n",
    "    x=\"BAIRRO\", \n",
    "    color=\"SITUACAO\",\n",
    "    title=\"6. Proporção de Resoluções nos 5 Bairros Críticos (100% Empilhado)\",\n",
    "    labels={\"BAIRRO\": \"Bairro\", \"SITUACAO\": \"Status\"},\n",
    "    barnorm=\"percent\",\n",
    "    color_discrete_sequence=px.colors.qualitative.Safe,\n",
    "    category_orders={\"BAIRRO\": bairros_criticos}\n",
    ")\n",
    "\n",
    "fig6.update_layout(\n",
    "    yaxis_title=\"Porcentagem (%)\", \n",
    "    xaxis_title=\"Bairro\",\n",
    "    bargap=0.2\n",
    ")\n",
    "\n",
    "fig6.show()"
   ]
