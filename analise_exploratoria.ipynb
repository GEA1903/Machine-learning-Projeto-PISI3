   "source": [
    "# 1. Isolar o grupo \"ILUMINACAO PUBLICA\"\n",
    "df_iluminacao = df_all[df_all['GRUPOSERVICO_DESCRICAO'] == 'ILUMINACAO PUBLICA'].copy()\n",
    "\n",
    "# 2. Função de limpeza focada nas Subcategorias de Iluminação\n",
    "def limpar_subcategoria(texto):\n",
    "    texto = str(texto).upper()\n",
    "    if 'APAGADA' in texto: return 'MANUTENÇÃO LÂMPADA APAGADA'\n",
    "    if 'ACENDER' in texto: return 'ACENDER CIRCUITO'\n",
    "    if 'LED' in texto: return 'IMPLANTAR LUMINÁRIA LED'\n",
    "    if 'APAGAR' in texto: return 'APAGAR LÂMPADA'\n",
    "    if 'LUMINARIA' in texto or 'LUMINRIA' in texto: return 'MANUTENÇÃO DE LUMINÁRIAS'\n",
    "    return texto.strip()\n",
    "\n",
    "# Aplica a limpeza\n",
    "df_iluminacao['SERVICO_DESCRICAO'] = df_iluminacao['SERVICO_DESCRICAO'].apply(limpar_subcategoria)\n",
    "\n",
    "# 3. Contar os Top 10 problemas consolidados\n",
    "top10_servicos = df_iluminacao['SERVICO_DESCRICAO'].value_counts().head(10).reset_index()\n",
    "top10_servicos.columns = ['Serviço', 'Volume']\n",
    "\n",
    "# 4. Gerar o Gráfico de Pareto Estilizado\n",
    "fig9 = px.bar(\n",
    "    top10_servicos, \n",
    "    x='Volume', \n",
    "    y='Serviço', \n",
    "    orientation='h',\n",
    "    title='9. Detalhamento Crítico: Principais Queixas em \"ILUMINAÇÃO PÚBLICA\"',\n",
    "    color='Volume',\n",
    "    color_continuous_scale='Reds',\n",
    "    labels={'Volume': 'Qtd. Ocorrências', 'Serviço': 'Subcategoria de Serviço'}\n",
    ")\n",
    "\n",
    "# Ajuste para as barras ficarem em ordem decrescente\n",
    "fig9.update_layout(yaxis={'categoryorder':'total ascending'}, showlegend=False)\n",
    "fig9.show()"
   ]
  },
