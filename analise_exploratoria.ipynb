    "vol_mensal = df_all['Ano_Mes'].value_counts().sort_index().reset_index()\n",
    "df_all['Data'] = pd.to_datetime(df_all['Ano_Mes']) # Ajuste o nome da coluna se necessário\n",
    "\n",
    "# 2. Filtrar apenas dados a partir de 01/01/2020\n",
    "df_filtrado = df_all[df_all['Data'] >= '2020-01-01']\n",
    "\n",
    "# 3. Gerar a contagem mensal com os dados filtrados\n",
    "vol_mensal = df_filtrado['Data'].dt.to_period('M').astype(str).value_counts().sort_index().reset_index()\n",
    "vol_mensal.columns = ['Mês', 'Volume de Denúncias']\n",
    "\n",
    "# 4. Criar o gráfico\n",
    "fig1 = px.line(vol_mensal, x='Mês', y='Volume de Denúncias', \n",
    "               title='1. Evolução do Volume Total de Denúncias (Série Histórica)',\n",
    "               title='1. Evolução do Volume Total de Denúncias (Pós-2019)',\n",
    "               markers=True)\n",
    "fig1.update_layout(xaxis_tickangle=-45)\n",
    "fig1.show()"
   ]
